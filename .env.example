# Copia este archivo a .env.local. Todas las variables son opcionales en modo demo.

# Secreto para firmar la cookie de sesión. Si se omite, se genera uno local en .data/auth-secret.
AUTH_SECRET=

# Carpeta de datos locales (base PGlite + archivos subidos). Por defecto: ./.data
HANDYMAN_DATA_DIR=

# Proveedor de pagos. Solo existe "demo" en el MVP.
PAYMENT_PROVIDER=demo
